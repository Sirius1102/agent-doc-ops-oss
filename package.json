    "test": "node dockit.js selftest",
    "doctor": "node dockit.js doctor"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@deepseek-ai/libreoffice-kit": "0.1.5",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1"
  }
}
